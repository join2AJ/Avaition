# Copy to .env and edit before `docker compose up`. NEVER commit the real .env.

# --- Runtime --------------------------------------------------------------
# development keeps convenient defaults; production makes the API fail-fast on
# any insecure default (weak SECRET_KEY, default admin password, wildcard CORS).
ENVIRONMENT=development
WEB_PORT=8080
WEB_CONCURRENCY=2
# Seeds schema + demo data on first boot. Set to false once your DB is populated.
SEED_ON_START=true

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=aep
POSTGRES_PASSWORD=aep_password
POSTGRES_DB=aep_portal

# --- Backend secrets (CHANGE THESE FOR PRODUCTION) ------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-to-a-random-secret-in-production
ADMIN_EMAIL=admin@aepportal.in
ADMIN_PASSWORD=Admin@123456
# Explicit allowlist of browser origins that may call the API (no wildcards in prod).
CORS_ORIGINS=http://localhost:8080

# --- MinIO / S3 (object store for attachments) ----------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_BUCKET=aep-attachments
