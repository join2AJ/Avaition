# Copy to .env and fill real values. In production (ENVIRONMENT=production) the
# app refuses to start if SECRET_KEY / ADMIN_PASSWORD are left at defaults or
# CORS_ORIGINS is a wildcard.

# development | production
ENVIRONMENT=development

DATABASE_URL=sqlite:///./aep_portal.db
# For Postgres: postgresql+psycopg2://user:password@localhost:5432/aep_portal

# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-to-a-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALGORITHM=HS256
UPLOAD_DIR=./uploads

ADMIN_EMAIL=admin@aepportal.in
ADMIN_PASSWORD=Admin@123456

# Explicit browser-origin allowlist for CORS (comma-separated). No wildcard in prod.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:4174
